@page "/settings/assistant"
@using FWO.Middleware.Client

@inject MiddlewareClient MiddlewareClient
@inject UserConfig userConfig

<div class="input-group">
    <h3>@(userConfig.GetText("assistant"))</h3>
    <HelpLink Page="settings/assistant" />
</div>

@if (Settings == null)
{
    <div class="spinner-border spinner-border-sm" role="status"></div>
}
else
{
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label">@(userConfig.GetText("system_prompt"))</label>
            <textarea class="form-control" rows="4" @bind="Settings.SystemPrompt" disabled="@ReadOnly"></textarea>
        </div>
        <div class="col-12">
            <h4>@(userConfig.GetText("provider"))</h4>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">@(userConfig.GetText("name"))</label>
            <input class="form-control" @bind="Settings.Provider.DisplayName" disabled="@ReadOnly" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">@(userConfig.GetText("provider"))</label>
            <select class="form-select" @bind="Settings.Provider.Kind" disabled="@ReadOnly">
                @foreach (AiProviderKind kind in Enum.GetValues<AiProviderKind>())
                {
                    <option value="@kind">@kind</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-5">
            <label class="form-label">@(userConfig.GetText("endpoint"))</label>
            <input class="form-control" @bind="Settings.Provider.EndpointUrl" disabled="@ReadOnly" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">@(userConfig.GetText("api_key_env_variable"))</label>
            <input class="form-control" @bind="Settings.Provider.ApiKeyEnvVariable" disabled="@ReadOnly" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">@(userConfig.GetText("timeout_seconds"))</label>
            <input class="form-control" type="number" min="1" @bind="Settings.Provider.TimeoutSeconds" disabled="@ReadOnly" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">@(userConfig.GetText("max_retries"))</label>
            <input class="form-control" type="number" min="0" @bind="Settings.Provider.MaxRetries" disabled="@ReadOnly" />
        </div>
        <div class="col-12">
            <h4>@(userConfig.GetText("model"))</h4>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">@(userConfig.GetText("name"))</label>
            <input class="form-control" @bind="Settings.Model.DisplayName" disabled="@ReadOnly" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">@(userConfig.GetText("model"))</label>
            <input class="form-control" @bind="Settings.Model.ModelId" disabled="@ReadOnly" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">@(userConfig.GetText("capabilities"))</label>
            <div>
                <label class="form-check-label me-3"><input type="checkbox" @bind="Settings.Model.StreamingSupported" disabled="@ReadOnly" /> @(userConfig.GetText("streaming"))</label>
                <label class="form-check-label me-3"><input type="checkbox" @bind="Settings.Model.ToolCallsSupported" disabled="@ReadOnly" /> @(userConfig.GetText("tool_calls"))</label>
                <label class="form-check-label me-3"><input type="checkbox" @bind="Settings.Model.VisionSupported" disabled="@ReadOnly" /> @(userConfig.GetText("vision"))</label>
                <label class="form-check-label me-3"><input type="checkbox" @bind="Settings.Model.ReasoningSupported" disabled="@ReadOnly" /> @(userConfig.GetText("reasoning"))</label>
            </div>
        </div>
        <div class="col-12">
            <label class="form-label mb-0">@(userConfig.GetText("generation_parameters"))</label>
        </div>
        <div class="col-6 col-md-2">
            <input class="form-control" type="number" placeholder="@(userConfig.GetText("context_size"))" @bind="Settings.Model.ContextSize" disabled="@ReadOnly" />
        </div>
        <div class="col-6 col-md-2">
            <input class="form-control" type="number" step="0.01" placeholder="@(userConfig.GetText("temperature"))" @bind="Settings.Model.Temperature" disabled="@ReadOnly" />
        </div>
        <div class="col-6 col-md-2">
            <input class="form-control" type="number" step="0.01" placeholder="@(userConfig.GetText("top_p"))" @bind="Settings.Model.TopP" disabled="@ReadOnly" />
        </div>
        <div class="col-6 col-md-2">
            <input class="form-control" type="number" placeholder="@(userConfig.GetText("top_k"))" @bind="Settings.Model.TopK" disabled="@ReadOnly" />
        </div>
        <div class="col-6 col-md-2">
            <input class="form-control" type="number" placeholder="@(userConfig.GetText("max_output_tokens"))" @bind="Settings.Model.MaxOutputTokens" disabled="@ReadOnly" />
        </div>
        <div class="col-6 col-md-2">
            <select class="form-select" @bind="Settings.Model.ReasoningEffort" disabled="@ReadOnly">
                @foreach (ReasoningEffort effort in ReasoningEfforts)
                {
                    <option value="@effort">@effort</option>
                }
            </select>
        </div>
    </div>

    <div class="mt-3 mb-4 d-flex gap-2">
        <button class="btn btn-primary" @onclick="Save" disabled="@ReadOnly">
            <span class="@Icons.Save"></span> @(userConfig.GetText("save"))
        </button>
        <button class="btn btn-outline-primary" @onclick="TestProvider" disabled="@ReadOnly">
            <span class="@Icons.TestConnection"></span> @(userConfig.GetText("test_connection"))
        </button>
    </div>
}

@code {
    [CascadingParameter]
    private Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private AiSettings? Settings { get; set; }
    private bool ReadOnly => !userConfig.User.Roles.Contains(Roles.Admin);
    internal static IReadOnlyList<ReasoningEffort> ReasoningEfforts { get; } = Enum.GetValues<ReasoningEffort>();

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        var response = await MiddlewareClient.GetAiSettings();
        Settings = response.IsSuccessful && response.Data != null ? response.Data : new AiSettings();
    }

    private async Task Save()
    {
        if (Settings == null)
        {
            return;
        }
        var response = await MiddlewareClient.SaveAiSettings(Settings);
        ShowResponseMessage("save", response, response.IsSuccessful ? userConfig.GetText("U0013") : null);
    }

    private async Task TestProvider()
    {
        if (Settings == null)
        {
            return;
        }
        var response = await MiddlewareClient.TestAiProvider(new AiConnectionTestParameters { Provider = Settings.Provider });
        ShowAiOperationResult("test_connection", response);
    }

    private string LocalizeResult(AiOperationResult? result)
    {
        if (result == null)
        {
            return "";
        }
        return string.Format(userConfig.GetText(result.MessageKey), result.MessageArgument);
    }

    private void ShowAiOperationResult(string titleTextId, RestSharp.RestResponse<AiOperationResult> response)
    {
        if (response.Data != null)
        {
            DisplayMessageInUi(response.ErrorException, userConfig.GetText(titleTextId), LocalizeResult(response.Data), !response.Data.Success);
            return;
        }
        ShowResponseMessage(titleTextId, response);
    }

    private void ShowResponseMessage<T>(string titleTextId, RestSharp.RestResponse<T> response, string? successMessage = null)
    {
        string message = successMessage ?? response.ErrorMessage ?? response.Content ?? userConfig.GetText("unspecified_error");
        DisplayMessageInUi(response.ErrorException, userConfig.GetText(titleTextId), message, !response.IsSuccessful);
    }
}
