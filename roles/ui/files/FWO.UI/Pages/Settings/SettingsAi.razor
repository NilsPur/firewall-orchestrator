@using FWO.Data.Ai

@page "/settings/ai"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig

<div class="input-group">
    <h3>@(userConfig.GetText("ai_settings"))</h3>
    <HelpLink Page="settings/ai" />
</div>
@(userConfig.GetText("U5332"))
<hr />

<form>
    <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5371"))">
        <label for="aiProvider" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_provider")):</label>
        <div class="col-sm-4">
            <select id="aiProvider" class="form-control form-control-sm" @bind="aiSettings.Provider">
                @foreach (AiProvider provider in kProviders)
                {
                    <option value="@provider">@(GetProviderName(provider))</option>
                }
            </select>
        </div>
    </div>
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5372"))">
        <label for="aiModel" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_model"))*:</label>
        <div class="col-sm-8">
            <input id="aiModel" type="text" class="form-control form-control-sm" maxlength="@kMaxModelLength" @bind="aiSettings.Model" />
        </div>
    </div>
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5373"))">
        <label for="aiEndpoint" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_endpoint")):</label>
        <div class="col-sm-8">
            <input id="aiEndpoint" type="url" class="form-control form-control-sm" maxlength="@kMaxEndpointLength" @bind="aiSettings.Endpoint" />
        </div>
    </div>
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5382"))">
        <label for="aiAuthMethod" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_auth_method")):</label>
        <div class="col-sm-4">
            <select id="aiAuthMethod" class="form-control form-control-sm" @bind="aiSettings.AuthMethod">
                @foreach (KeyValuePair<AiAuthMethod, string> authMethod in kAuthMethodTextKeys)
                {
                    <option value="@authMethod.Key">@(userConfig.GetText(authMethod.Value))</option>
                }
            </select>
        </div>
    </div>
    @if (aiSettings.AuthMethod == AiAuthMethod.OAuth2ClientCredentials)
    {
        <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5383"))">
            <label for="aiTokenUrl" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_token_url"))*:</label>
            <div class="col-sm-8">
                <input id="aiTokenUrl" type="url" class="form-control form-control-sm" maxlength="@kMaxEndpointLength" @bind="aiSettings.TokenUrl" />
            </div>
        </div>
    }
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5374"))">
        <label for="aiCredential" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_credential")):</label>
        <div class="col-sm-8">
            <select id="aiCredential" class="form-control form-control-sm" @bind="aiSettings.CredentialId">
                <option value="0">@(userConfig.GetText("none"))</option>
                @foreach (Credential credential in credentials)
                {
                    <option value="@credential.Id">@credential.Name</option>
                }
                @if (IsUnknownCredential())
                {
                    <option value="@aiSettings.CredentialId">@aiSettings.CredentialId</option>
                }
            </select>
        </div>
    </div>
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5375"))">
        <label for="aiContextWindowTokens" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_context_window_tokens"))*:</label>
        <div class="col-sm-2">
            <input id="aiContextWindowTokens" type="number" min="1" class="form-control form-control-sm" @bind="aiSettings.ContextWindowTokens" />
        </div>
    </div>
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5376"))">
        <label for="aiMaxOutputTokens" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_max_output_tokens")):</label>
        <div class="col-sm-2">
            <input id="aiMaxOutputTokens" type="number" min="0" class="form-control form-control-sm" @bind="aiSettings.MaxOutputTokens" />
        </div>
    </div>
    <hr />
    <h5>@(userConfig.GetText("ai_agent_loop"))</h5>
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5378"))">
        <label for="aiMaxIterations" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_max_iterations")):</label>
        <div class="col-sm-2">
            <input id="aiMaxIterations" type="number" min="1" class="form-control form-control-sm" @bind="aiSettings.MaxIterationsPerRequest" />
        </div>
    </div>
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5379"))">
        <label for="aiMaxConsecutiveErrors" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_max_consecutive_errors")):</label>
        <div class="col-sm-2">
            <input id="aiMaxConsecutiveErrors" type="number" min="0" class="form-control form-control-sm" @bind="aiSettings.MaxConsecutiveErrorsPerRequest" />
        </div>
    </div>
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5380"))">
        <label for="aiCompactionReserveTokens" class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("ai_compaction_reserve_tokens")):</label>
        <div class="col-sm-2">
            <input id="aiCompactionReserveTokens" type="number" min="0" class="form-control form-control-sm" @bind="aiSettings.CompactionReserveTokens" />
        </div>
    </div>
</form>
<hr />

<div class="btn-group">
    <ExecutionModeAuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <button type="button" class="btn btn-sm btn-primary" @onclick="Save">@(userConfig.GetText("save"))</button>
        </Authorized>
        <NotAuthorized>
            <button type="button" class="btn btn-sm btn-primary" disabled>@(userConfig.GetText("save"))</button>
        </NotAuthorized>
    </ExecutionModeAuthorizeView>
</div>

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private const int kMaxModelLength = 256;
    private const int kMaxEndpointLength = 2048;

    private static readonly List<AiProvider> kProviders = [.. Enum.GetValues<AiProvider>()];

    private static readonly Dictionary<AiAuthMethod, string> kAuthMethodTextKeys = new()
    {
        [AiAuthMethod.ApiKey] = "ai_auth_api_key",
        [AiAuthMethod.OAuth2ClientCredentials] = "ai_auth_oauth2_client_credentials"
    };

    private ConfigData? editableConfig;
    private AiSettings aiSettings = new();
    private List<Credential> credentials = [];

    /// <summary>
    /// Loads the AI settings and the credentials that can hold an API key or an OAuth client secret (no key pairs),
    /// without their secrets.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            editableConfig = await globalConfig.GetEditableConfig();
            aiSettings = editableConfig.GetAiSettings();
            List<Credential> allCredentials = await apiConnection.SendQueryAsync<List<Credential>>(DeviceQueries.getCredentialsWithoutSecrets);
            credentials = [.. allCredentials.Where(credential => !credential.IsKeyPair).OrderBy(credential => credential.Name)];
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    /// <summary>
    /// Checks the AI settings like the AI harness does and stores them; the harness applies them at its next reading.
    /// </summary>
    private async Task Save()
    {
        try
        {
            if (editableConfig == null || !CheckValues())
            {
                return;
            }
            editableConfig.SetAiSettings(aiSettings);
            await globalConfig.WriteToDatabase(editableConfig, apiConnection);
            DisplayMessageInUi(null, userConfig.GetText("save_ai_settings"), userConfig.GetText("U5301"), false);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("save_ai_settings"), "", true);
        }
    }

    /// <summary>
    /// Shows the problems of the AI settings; true if there are none.
    /// </summary>
    private bool CheckValues()
    {
        List<AiSettingsProblem> problems = aiSettings.Validate();
        if (problems.Count == 0)
        {
            return true;
        }
        IEnumerable<string> messages = problems.Select(problem => userConfig.GetText(AiSettingsProblemTexts.GetTextKey(problem)));
        DisplayMessageInUi(null, userConfig.GetText("save_ai_settings"), string.Join(" ", messages), true);
        return false;
    }

    /// <summary>
    /// Returns the name shown for a provider; the localized "none" for no provider.
    /// </summary>
    private string GetProviderName(AiProvider provider)
    {
        return provider == AiProvider.None ? userConfig.GetText("none") : provider.ToString();
    }

    /// <summary>
    /// Tells whether the settings reference a credential that is not offered, e.g. a key pair, so that it stays visible.
    /// </summary>
    private bool IsUnknownCredential()
    {
        return aiSettings.CredentialId > 0 && !credentials.Any(credential => credential.Id == aiSettings.CredentialId);
    }
}
