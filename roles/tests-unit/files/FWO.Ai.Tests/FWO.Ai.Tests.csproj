<Project Sdk="Microsoft.NET.Sdk">

	<!-- Separate from FWO.Test, so the MCP server tests run on the middleware host it is installed on and FWO.Test does not need its sources. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NUnit" Version="4.6.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\ai\files\FWO.Ai.Mcp\FWO.Ai.Mcp.csproj" />
		<ProjectReference Include="..\..\..\ai\files\FWO.Ai.Harness\FWO.Ai.Harness.csproj" />
		<ProjectReference Include="..\..\..\lib\files\FWO.Ai.Client\FWO.Ai.Client.csproj" />
	</ItemGroup>

</Project>
